// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tour {
  id                   String    @id
  slug                 String    @unique
  title                String
  maxPhotographers     Int
  availableSlots       Int
  date                 String
  location             String
  price                String
  duration             String
  overview             String
  focusSpecies         String[]
  itinerary            Json // Array of: { day: string, title: string, description: string }
  included             String[]
  notIncluded          String[]
  equipment            String[]
  image                String
  gallery              String[]
  nonRefundableDeposit Int
  bookings             Booking[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Booking {
  id              String   @id @default(cuid())
  tourId          String
  tour            Tour     @relation(fields: [tourId], references: [id])
  customerEmail   String
  amount          Int
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())
}
