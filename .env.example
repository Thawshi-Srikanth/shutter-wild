# Stripe keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Database (Use a pooled PostgreSQL connection string for Vercel serverless, e.g. Neon)
DATABASE_URL=
NODE_ENV=

# Vercel Blob Storage (auto-populated when linking a Blob store in Vercel)
BLOB_READ_WRITE_TOKEN=

# Admin Authentication
ADMIN_PASSWORD=

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
ADMIN_EMAIL=admin@shutterwild.co.uk
EMAIL_FROM="Shutter Wild <noreply@shutterwild.co.uk>"
